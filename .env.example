NODE_ENV=production
PORT=10000

APP_NAME=QR Platform
APP_URL=https://qr-platform-api.onrender.com
FRONTEND_URL=https://qr-platform-dashboard.vercel.app
QR_BASE_URL=https://qr-platform-api.onrender.com/q

DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=qr_platform
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_SSL=true
# Recommended with Aiven: base64-encoded CA certificate
DB_SSL_CA_BASE64=
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
